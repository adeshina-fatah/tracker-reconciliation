# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=

# Display name of the shared folder exactly as shown in Outlook, e.g. "Khomanani Shared"
MAIL_FOLDER_NAME=

# outlook = read through the Outlook desktop client already signed in on this PC (default, no extra credentials)
# graph   = Microsoft Graph; needs an Entra app registration from IT
MAIL_BACKEND=outlook
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
