# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=

# Folder(s) to search, comma-separated, e.g. "Khomanani Shared, Inbox". "Inbox" means your main inbox.
# If several folders share the name, give the path: "Mailbox Name/Inbox/Khomanani Shared"
MAIL_FOLDER_NAME=

# outlook = read through the Outlook desktop client already signed in on this PC (default, no extra credentials)
# graph   = Microsoft Graph; needs an Entra app registration from IT
MAIL_BACKEND=outlook
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
